{
  "name": "access-main",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ontario accessibility prototype. The web shell is apps/web. Shared JSON Schema and verification tiers are @access-main/schema.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "exports": {
    "./schema": "./packages/schema/dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lanes:sync": "node scripts/sync-lanes.mjs",
    "lanes:ensure": "node scripts/sync-lanes.mjs --if-missing",
    "predev": "npm run lanes:ensure",
    "dev": "npm run dev -w @access/web",
    "build": "npm run lanes:ensure && npm run hub:sync && npm run build -w @access-main/schema && npm run build -w @access/web",
    "preview": "npm run preview -w @access/web",
    "prepare": "tsc -p packages/schema/tsconfig.json",
    "pretypecheck": "npm run lanes:ensure && npm run hub:sync",
    "typecheck": "tsc -p packages/schema/tsconfig.json && tsc -p packages/shared/tsconfig.json && tsc -p apps/web/tsconfig.json && tsc -p apps/web/tsconfig.scripts.json && tsc -p apps/web/tsconfig.node.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "pretest": "npm run lanes:ensure && npm run hub:sync",
    "test": "vitest run && npm test --workspaces --if-present && npm run test:scripts && npm run test:release",
    "test:scripts": "node --experimental-strip-types --test scripts/sync-lanes.test.mjs apps/web/e2e/a11y-input/record-audit-round10.node.mjs scripts/p16-offline-history-round16.node.mjs scripts/p16-offline-readiness-round19.node.mjs scripts/p16-offline-receipt-round17.node.mjs scripts/p16-source-drift-round21.node.mjs scripts/p16-accessible-export-round20.node.mjs scripts/p16-publication-round23/contract.node.mjs scripts/p16-publication-round23/readiness.node.mjs scripts/p16-publication-round23/changes.node.mjs scripts/p16-publication-round23/export.node.mjs scripts/p16-packet-round24/core.node.mjs scripts/p16-packet-round24/locale.node.mjs scripts/p16-packet-round24/readiness.node.mjs scripts/p16-packet-round24/changes.node.mjs scripts/p16-packet-round24/export.node.mjs scripts/p16-evidence-triage-round27/contracts.node.mjs scripts/p16-evidence-triage-round27/readiness.node.mjs scripts/p16-evidence-triage-round27/changes.node.mjs scripts/p16-evidence-triage-round27/export.node.mjs scripts/p16-evidence-triage-round27/lineage.node.mjs scripts/p16-casebook-round30/model.node.mjs scripts/p16-casebook-round30/decisions.node.mjs scripts/p16-casebook-round30/events.node.mjs scripts/p16-casebook-round30/diff.node.mjs scripts/p16-casebook-round30/export.node.mjs apps/web/src/input/rehearsal/model.node.mjs apps/web/src/input/rehearsal/scanner.node.mjs apps/web/src/input/rehearsal/report.node.mjs apps/web/src/input/rehearsal/semantics.node.mjs apps/web/src/input/rehearsal/integration.node.mjs apps/web/src/input/rehearsal/wiring.node.mjs apps/web/src/input/rehearsal/edge.node.mjs apps/web/e2e/axe-sweep/p20aj-evidence.node.mjs apps/web/e2e/axe-sweep/p20aj-focus.node.mjs apps/web/e2e/axe-sweep/p20aj-language.node.mjs apps/web/e2e/axe-sweep/p20aj-offline.node.mjs apps/web/e2e/axe-sweep/p20aj-replay.node.mjs apps/web/e2e/axe-sweep/p20am-browser.node.mjs apps/web/e2e/axe-sweep/p20am-copy.node.mjs apps/web/e2e/axe-sweep/p20am-custody.node.mjs apps/web/e2e/axe-sweep/p20am-integration.node.mjs apps/web/e2e/axe-sweep/p20am-model.node.mjs apps/web/e2e/axe-sweep/p20am-policy.node.mjs apps/web/e2e/axe-sweep/p20al-contract.node.mjs apps/web/e2e/axe-sweep/p20al-handoff.node.mjs apps/web/e2e/axe-sweep/p20al-matrix-keyboard.node.mjs apps/web/e2e/axe-sweep/p20an-browser.node.mjs apps/web/e2e/axe-sweep/p20an-evidence.node.mjs apps/web/e2e/axe-sweep/p20an-interactions.node.mjs apps/web/e2e/axe-sweep/p20an-offline.node.mjs apps/web/e2e/axe-sweep/p20an-report.node.mjs apps/web/src/offline/evidence-workbench/model.test.mjs apps/web/src/offline/evidence-workbench/operations.test.mjs apps/web/src/offline/evidence-workbench/analysis.test.mjs apps/web/src/offline/evidence-workbench/export.test.mjs apps/web/src/offline/evidence-workbench/mounting.test.mjs apps/web/src/input/switch-workbench/integration.node.mjs",
    "test:release": "npm run test --prefix scripts/release",
    "verify": "npm run test:release && node --experimental-strip-types scripts/release/check.mjs --dir apps/web/dist && node scripts/release/audit.mjs --dir apps/web/dist && node scripts/release/deep-audit.mjs --dir apps/web/dist && node --experimental-strip-types scripts/release/preflight.mjs --root . --dist apps/web/dist",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "validate": "npm run validate -w @access-main/schema --",
    "count": "npm run count -w @access-main/schema --",
    "postdemo": "node apps/web/scripts/postdemo.ts",
    "hub:sync": "node scripts/sync-hub.mjs",
    "prebuild": "npm run hub:sync"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^27.2.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  },
  "license": "MIT"
}
