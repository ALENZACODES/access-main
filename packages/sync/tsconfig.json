{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true, "resolveJsonModule": true,
    "jsx": "react-jsx", "types": ["vitest/globals", "node"]
  },
  "include": ["src", "e2e", "*.ts"]
}
