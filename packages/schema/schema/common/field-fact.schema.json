{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-main.local/schema/common/field-fact.schema.json",
  "title": "FieldFact",
  "description": "One field value with source, licence, retrieval date, and verification tier. unknown and UNKNOWN mean the source did not state the fact. They are not zeroes and they do not count unless tri_state_observation is true and method, observed_at, and source are present.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value",
    "source_id",
    "licence",
    "retrieved_at",
    "tier"
  ],
  "properties": {
    "value": {
      "description": "Published value, an unparsed source token, or an explicit unknown token.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      ]
    },
    "unit": {
      "anyOf": [
        {
          "enum": [
            "mm",
            "m",
            "kg",
            "percent",
            "degrees",
            "ratio"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "licence": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date"
    },
    "tier": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        "E"
      ]
    },
    "source_name": {
      "type": "string",
      "minLength": 1
    },
    "source_key": {
      "type": "string"
    },
    "import_field": {
      "type": "string",
      "description": "access-maps field name when this fact was migrated. Not a separate piece."
    },
    "raw": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "derived": {
      "type": "boolean"
    },
    "tri_state_observation": {
      "type": "boolean",
      "description": "True only when unknown itself was observed and recorded with method and date."
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tier": {
            "const": 3
          }
        },
        "required": [
          "tier"
        ]
      },
      "then": {
        "required": [
          "evidence",
          "method",
          "observed_at"
        ],
        "properties": {
          "evidence": {
            "required": [
              "protocol_version",
              "verifier_role",
              "method",
              "observed_at"
            ],
            "properties": {
              "protocol_version": true,
              "verifier_role": true,
              "method": true,
              "observed_at": true
            }
          },
          "method": true,
          "observed_at": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "tri_state_observation": {
            "const": true
          }
        },
        "required": [
          "tri_state_observation"
        ]
      },
      "then": {
        "required": [
          "method",
          "observed_at",
          "source_id"
        ],
        "properties": {
          "method": true,
          "observed_at": true,
          "source_id": true
        }
      }
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "verifier_role",
        "method",
        "observed_at"
      ],
      "properties": {
        "protocol_version": {
          "type": "string",
          "minLength": 1
        },
        "verifier_role": {
          "enum": [
            "trained_verifier",
            "peer",
            "operator",
            "importer",
            "desk_reviewer"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date"
        },
        "photo_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
