{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-main.local/schema/canonical/game-definition.schema.json",
  "title": "Game definition",
  "description": "One of the ten starter games named in the Part 5 scope lock. The notice id is required. No health or cognition outcome is stored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "id",
    "name",
    "timing_mode",
    "input_modes",
    "colour_independence_note",
    "no_medical_claims_notice_id",
    "publication_context",
    "provenance"
  ],
  "properties": {
    "record_type": {
      "const": "game_definition"
    },
    "schema_version": {
      "const": "game-definition-1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "boolean"
    },
    "publication_context": {
      "enum": [
        "canonical",
        "prototype"
      ]
    },
    "name": {
      "enum": [
        "Grid Recall",
        "Pair Sequence",
        "Route Planner",
        "Pattern Rules",
        "Word Roots Builder",
        "Number Compare",
        "Focus Flankers",
        "Switch Rules",
        "Shape Assembly",
        "Order Keeper"
      ]
    },
    "task_family": {
      "type": "string"
    },
    "timing_mode": {
      "type": "string",
      "minLength": 1
    },
    "input_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "keyboard",
          "tap",
          "switch",
          "voice"
        ]
      }
    },
    "colour_independence_note": {
      "type": "string",
      "minLength": 1
    },
    "no_medical_claims_notice_id": {
      "const": "notice.games.no-medical-or-cognitive-claims.v1"
    },
    "provenance": {
      "$ref": "https://access-main.local/schema/common/provenance.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_context": {
            "const": "prototype"
          }
        },
        "required": [
          "publication_context"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "required": [
              "prototype_label"
            ],
            "properties": {
              "prototype_label": {
                "enum": [
                  "PROTOTYPE-UNVERIFIED",
                  "SEEDED-OPEN-DATA"
                ]
              },
              "tier": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        }
      }
    }
  ]
}
