{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-main.local/schema/canonical/city-skeleton.schema.json",
  "title": "City skeleton",
  "description": "A thin city record. not_yet_seeded must name at least one gap. It cannot imply a deep seed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "id",
    "city_name",
    "province",
    "not_yet_seeded",
    "provenance",
    "publication_context"
  ],
  "properties": {
    "record_type": {
      "const": "city_skeleton"
    },
    "schema_version": {
      "const": "city-skeleton-1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "boolean"
    },
    "publication_context": {
      "enum": [
        "canonical",
        "prototype"
      ]
    },
    "city_name": {
      "type": "string",
      "minLength": 1
    },
    "province": {
      "const": "Ontario"
    },
    "transit_system_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paratransit_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            "unknown",
            "UNKNOWN"
          ]
        }
      ]
    },
    "booking_contact": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            "unknown",
            "UNKNOWN"
          ]
        }
      ]
    },
    "not_yet_seeded": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "$ref": "https://access-main.local/schema/common/provenance.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_context": {
            "const": "prototype"
          }
        },
        "required": [
          "publication_context"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "required": [
              "prototype_label"
            ],
            "properties": {
              "prototype_label": {
                "enum": [
                  "PROTOTYPE-UNVERIFIED",
                  "SEEDED-OPEN-DATA"
                ]
              },
              "tier": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        }
      }
    }
  ]
}
