    {
      "contains": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "Switch Rules"
          }
        }
      }
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "Shape Assembly"
          }
        }
      }
