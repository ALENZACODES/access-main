          "name": {
            "const": "Grid Recall"
          }
        }
      }
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "Pair Sequence"
          }
        }
      }
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "Route Planner"
          }
        }
      }
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "Pattern Rules"
          }
        }
      }
    },
    {
      "contains": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "const": "Word Roots Builder"
          }
        }
