{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-main.local/schema/canonical/game-definition-set.schema.json",
  "title": "Ten starter games",
  "type": "array",
  "minItems": 10,
  "maxItems": 10,
  "items": {
    "$ref": "https://access-main.local/schema/canonical/game-definition.schema.json"
  },
  "allOf": [
