        "signage_note": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Directions from the street and accessible-entrance signage.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
