      },
      "description": "Plan fields. Absent means not collected. unknown means collected as unknown."
    },
    "imported_facts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
      },
      "description": "Original access-maps keys that have no safe canonical rename. Counted once. Not a second copy of facts."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_context": {
            "const": "prototype"
          }
        },
        "required": [
          "publication_context"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "required": [
              "prototype_label"
            ],
            "properties": {
              "prototype_label": {
                "enum": [
                  "PROTOTYPE-UNVERIFIED",
                  "SEEDED-OPEN-DATA"
                ]
              },
              "tier": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "published"
          }
        },
        "required": [
          "record_status"
        ]
      },
      "then": {
        "required": [
          "place_id"
        ],
        "properties": {
          "place_id": true
        }
      }
    }
  ]
}
