                "value": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "door_opening_force_note": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Observed heavy, moderate, or light, with the method note. No invented Newton value.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "door_swing": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Door swing as observed.",
              "properties": {
                "value": {
                  "enum": [
                    "outward",
                    "inward",
                    "sliding",
                    "revolving",
                    "other",
                    "unknown",
                    "UNKNOWN"
                  ]
                }
              }
            }
          ]
        },
        "ramp_present": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Ramp present at this entrance.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "ramp_gradient_ratio": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Ratio computed from recorded rise and run. A ratio alone is not accepted as a measurement.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "ramp_rise_mm": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Total rise, bottom to top, measured.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "value"
                    ]
                  },
                  "then": {
                    "required": [
                      "unit"
                    ],
                    "properties": {
                      "unit": {
                        "const": "mm"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "ramp_run_mm": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Total run, measured.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "value"
                    ]
                  },
                  "then": {
                    "required": [
                      "unit"
                    ],
                    "properties": {
                      "unit": {
                        "const": "mm"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "ramp_length_mm": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Total length including landings.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "value"
                    ]
                  },
                  "then": {
                    "required": [
                      "unit"
                    ],
                    "properties": {
                      "unit": {
                        "const": "mm"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "ramp_clear_width_mm": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Clear width between handrails at the narrowest point.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "value"
                    ]
                  },
                  "then": {
                    "required": [
                      "unit"
                    ],
                    "properties": {
                      "unit": {
                        "const": "mm"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "ramp_landing_top_mm": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Top landing length and width, clear of the door swing.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "ramp_landing_bottom_mm": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Bottom landing length and width, clear of obstructions.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "ramp_handrails": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Handrails as observed.",
              "properties": {
                "value": {
                  "enum": [
                    "both_sides",
                    "one_side",
                    "none",
                    "other",
                    "unknown",
                    "UNKNOWN"
                  ]
                }
              }
            }
          ]
        },
        "ramp_surface": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Ramp surface with slip and drainage note.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "approach_surface": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Approach surface and condition.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "approach_width_min_mm": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Narrowest clear approach width, excluding obstructions at the time of verification.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "value"
                    ]
                  },
                  "then": {
                    "required": [
                      "unit"
                    ],
                    "properties": {
                      "unit": {
                        "const": "mm"
                      }
                    }
