{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-main.local/schema/canonical/journey.schema.json",
  "title": "Journey",
  "description": "A derived trip plan. step_free_status is required on every leg and has no default. unknown is not step-free. Times are scheduled. The journey does not count toward the headline piece total.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "id",
    "realtime_claimed",
    "explanation",
    "legs",
    "provenance",
    "publication_context"
  ],
  "properties": {
    "record_type": {
      "const": "journey"
    },
    "schema_version": {
      "const": "journey-1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "boolean"
    },
    "publication_context": {
      "enum": [
        "canonical",
        "prototype"
      ]
    },
    "realtime_claimed": {
      "const": false
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "https://access-main.local/schema/common/provenance.schema.json"
    },
    "legs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "leg_id",
          "mode",
          "step_free_status",
          "source_name"
        ],
        "properties": {
          "leg_id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "walk_roll",
              "transit",
              "paratransit_link",
              "transfer",
              "return"
            ]
          },
          "from_label": {
            "type": "string"
          },
          "to_label": {
            "type": "string"
          },
          "step_free_status": {
            "enum": [
              "step_free",
              "unknown",
              "not_step_free"
            ]
          },
          "distance_m": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "enum": [
                  "unknown",
                  "UNKNOWN"
                ]
              }
            ]
          },
          "surface_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "enum": [
                  "unknown",
                  "UNKNOWN"
                ]
              }
            ]
          },
          "gradient_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "enum": [
                  "unknown",
                  "UNKNOWN"
                ]
              }
            ]
          },
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "time_label": {
            "const": "scheduled"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_context": {
            "const": "prototype"
          }
        },
        "required": [
          "publication_context"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "required": [
              "prototype_label"
            ],
            "properties": {
              "prototype_label": {
                "enum": [
                  "PROTOTYPE-UNVERIFIED",
                  "SEEDED-OPEN-DATA"
                ]
              },
              "tier": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        }
      }
    }
  ]
}
