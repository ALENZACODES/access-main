{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-main.local/schema/canonical/washroom.schema.json",
  "title": "Washroom",
  "description": "One washroom, including adult change table and hoist fields. Baby changing is not an adult change table. A hoist without a sling policy is not a complete hoist record. Part 3 section 3.8.",
