{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-main.local/schema/canonical/charging.schema.json",
  "title": "Charging",
  "description": "One charging point for a mobility device or a phone. Presence without connector, hours, and access is not a complete charging fact set. Part 1 section 5.2 transport, charging, and live-status fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "id",
    "record_status",
    "publication_context",
    "provenance"
  ],
  "properties": {
    "record_type": {
      "const": "charging"
    },
    "example": {
      "type": "boolean",
      "description": "True on a synthetic fixture. The counter excludes example records from the headline."
    },
    "publication_context": {
      "enum": [
        "canonical",
        "prototype"
      ]
    },
    "provenance": {
      "$ref": "https://access-main.local/schema/common/provenance.schema.json"
    },
    "id": {
      "description": "Stable id. Does not count.",
      "type": "string"
    },
    "schema_version": {
      "const": "charging-1.0.0",
      "description": "Schema version. Does not count."
    },
    "record_status": {
      "description": "Publication status. Does not count.",
      "enum": [
        "draft",
        "in_review",
        "published",
        "stale_flagged",
        "archived",
        "disputed"
      ]
    },
    "place_id": {
      "description": "Place id when the point is inside a place. Does not count.",
      "type": "string"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "charging_present": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Whether a charging point was observed or published.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "location_description": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Where the outlet is.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "connector_type": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Connector as labelled. Do not guess a plug from a photo that does not show it.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "plug_type": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Plug type as labelled.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "hours": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Hours charging is available.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "access_note": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Who can use it and how, as published or observed.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "cost_note": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Cost or free status as published. Not pricing advice.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "seating_while_charging": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Seating while charging.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "description": "Plan fields. Absent means not collected. unknown means collected as unknown."
    },
    "imported_facts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
      },
      "description": "Original access-maps keys that have no safe canonical rename. Counted once. Not a second copy of facts."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_context": {
            "const": "prototype"
          }
        },
        "required": [
          "publication_context"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "required": [
              "prototype_label"
            ],
            "properties": {
              "prototype_label": {
                "enum": [
                  "PROTOTYPE-UNVERIFIED",
                  "SEEDED-OPEN-DATA"
                ]
              },
              "tier": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "published"
          }
        },
        "required": [
          "record_status"
        ]
      },
      "then": {
        "properties": {
          "facts": {
            "type": "object",
            "required": [
              "charging_present"
            ],
            "properties": {
              "charging_present": true
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "published"
          }
        },
        "required": [
          "record_status"
        ]
      },
      "then": {
        "required": [
          "place_id"
        ],
        "properties": {
          "place_id": true
        }
      }
    }
  ]
}
