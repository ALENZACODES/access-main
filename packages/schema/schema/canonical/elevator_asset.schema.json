{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-main.local/schema/canonical/elevator_asset.schema.json",
  "title": "Elevator asset",
  "description": "One elevator or escalator asset. Live status is a separate outage record so a stale status cannot overwrite the asset. Part 1 section 5.2 and Part 3 section 3.9.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "id",
    "record_status",
    "publication_context",
    "provenance"
  ],
  "properties": {
    "record_type": {
      "const": "elevator_asset"
    },
    "example": {
      "type": "boolean",
      "description": "True on a synthetic fixture. The counter excludes example records from the headline."
    },
    "publication_context": {
      "enum": [
        "canonical",
        "prototype"
      ]
    },
    "provenance": {
      "$ref": "https://access-main.local/schema/common/provenance.schema.json"
    },
    "id": {
      "description": "Stable id. Does not count.",
      "type": "string"
    },
    "schema_version": {
      "const": "elevator-asset-1.0.0",
      "description": "Schema version. Does not count."
    },
    "record_status": {
      "description": "Publication status. Does not count.",
      "enum": [
        "draft",
        "in_review",
        "published",
        "stale_flagged",
        "archived",
        "disputed"
      ]
    },
    "parent_id": {
      "description": "Station or place id. Does not count.",
      "type": "string"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_kind": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Asset kind.",
              "properties": {
                "value": {
                  "enum": [
                    "elevator",
                    "escalator",
                    "platform_lift",
                    "other",
                    "unknown",
                    "UNKNOWN"
                  ]
                }
              }
            }
          ]
        },
        "asset_name": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Operator's name or code for this asset.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "operator_name": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Who operates the asset. Displayed with the help number. Not an endorsement.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "help_number": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Help number published for this asset, such as an elevator status line.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "floors_served": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Floors served as published or observed.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "car_width_mm": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Car width measured or taken from an operator sheet that states the dimension.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "value"
                    ]
                  },
                  "then": {
                    "required": [
                      "unit"
                    ],
                    "properties": {
                      "unit": {
                        "const": "mm"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "car_depth_mm": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Car depth measured or taken from an operator sheet that states the dimension.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "value"
                    ]
                  },
                  "then": {
                    "required": [
                      "unit"
                    ],
                    "properties": {
                      "unit": {
                        "const": "mm"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "door_clear_width_mm": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Door clear width.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "value": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "value"
                    ]
                  },
                  "then": {
                    "required": [
                      "unit"
                    ],
                    "properties": {
                      "unit": {
                        "const": "mm"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "control_height_note": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Control heights as measured or published.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "signals_note": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Audible and visible signals as observed.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "single_point_of_failure": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "True when this asset is the only step-free path. Unknown stays unknown.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        "alternate_route_note": {
          "allOf": [
            {
              "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
            },
            {
              "description": "Alternate step-free route when one has been verified. Absence of text is not an alternate.",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "unknown",
                        "UNKNOWN"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "description": "Plan fields. Absent means not collected. unknown means collected as unknown."
    },
    "imported_facts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://access-main.local/schema/common/field-fact.schema.json"
      },
      "description": "Original access-maps keys that have no safe canonical rename. Counted once. Not a second copy of facts."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_context": {
            "const": "prototype"
          }
        },
        "required": [
          "publication_context"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "required": [
              "prototype_label"
            ],
            "properties": {
              "prototype_label": {
                "enum": [
                  "PROTOTYPE-UNVERIFIED",
                  "SEEDED-OPEN-DATA"
                ]
              },
              "tier": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "published"
          }
        },
        "required": [
          "record_status"
        ]
      },
      "then": {
        "properties": {
          "facts": {
            "type": "object",
            "required": [
              "asset_kind",
              "operator_name"
            ],
            "properties": {
              "asset_kind": true,
              "operator_name": true
            }
          }
        }
      }
    }
  ]
}
