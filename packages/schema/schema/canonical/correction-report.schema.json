{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-main.local/schema/canonical/correction-report.schema.json",
  "title": "Correction report",
  "description": "A local correction. Prototype reports stay pending and do not change the published record. Free text does not count as pieces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "schema_version",
    "id",
    "target_record_type",
    "target_record_id",
    "field_name",
    "suggested_correction",
    "moderation_status",
    "storage",
    "changes_published_record",
    "provenance",
    "publication_context"
  ],
  "properties": {
    "record_type": {
      "const": "correction_report"
    },
    "schema_version": {
      "const": "correction-report-1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "boolean"
    },
    "publication_context": {
      "enum": [
        "canonical",
        "prototype"
      ]
    },
    "target_record_type": {
      "enum": [
        "place",
        "entrance",
        "washroom",
        "parking",
        "transit_stop",
        "segment",
        "elevator_asset",
        "outage"
      ]
    },
    "target_record_id": {
      "type": "string",
      "minLength": 1
    },
    "field_name": {
      "type": "string",
      "minLength": 1
    },
    "suggested_correction": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "moderation_status": {
      "const": "pending"
    },
    "storage": {
      "const": "local_device_only"
    },
    "changes_published_record": {
      "const": false
    },
    "provenance": {
      "$ref": "https://access-main.local/schema/common/provenance.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "publication_context": {
            "const": "prototype"
          }
        },
        "required": [
          "publication_context"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "type": "object",
            "required": [
              "prototype_label"
            ],
            "properties": {
              "prototype_label": {
                "enum": [
                  "PROTOTYPE-UNVERIFIED",
                  "SEEDED-OPEN-DATA"
                ]
              },
              "tier": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        }
      }
    }
  ]
}
