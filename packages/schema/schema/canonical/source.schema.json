{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://access-main.local/schema/canonical/source.schema.json",
  "title": "Source",
  "description": "A dataset or feed in the source register. Compatible with the access-maps source registry entry, which does not yet store share_alike. Provenance, not a headline data piece. odblShareAlikeMissing reports an ODbL row whose share_alike is not true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "url",
    "download_url",
    "licence_name",
    "licence_url",
    "licence_id",
    "attribution",
    "retrieved_at",
    "tier"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "osm",
        "gtfs",
        "municipal",
        "operator_page",
        "desk",
        "field_verification",
        "user_report"
      ]
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "download_url": {
      "type": "string",
      "minLength": 1
    },
    "licence_name": {
      "type": "string",
      "minLength": 1
    },
    "licence_url": {
      "type": "string",
      "minLength": 1
    },
    "licence_id": {
      "type": "string",
      "minLength": 1
    },
    "attribution": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date"
    },
    "tier": {
      "enum": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "tier_note": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "share_alike": {
      "type": "boolean"
    },
    "confirmation_status": {
      "enum": [
        "confirmed",
        "pending"
      ]
    }
  }
}
