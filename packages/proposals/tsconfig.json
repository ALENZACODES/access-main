{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "test/**/*.spec.tsx"
  ]
}
