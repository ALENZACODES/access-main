    "audit:custody": "node --experimental-strip-types artifact-custody-cli.mjs",
    "audit:conflicts": "node --experimental-strip-types offline-conflict-cli.mjs",
    "audit:recovery-traces": "node --experimental-strip-types offline-recovery-trace-cli.mjs",
    "audit:ui-snapshots": "node --experimental-strip-types snapshot-a11y-cli.mjs",
    "audit:input-continuity": "node --experimental-strip-types input-continuity-cli.mjs",
    "audit:evidence-review": "node --experimental-strip-types offline-evidence-review-cli.mjs",
    "audit:update-rehearsal": "node --experimental-strip-types offline-update-rehearsal-cli.mjs",
    "audit:review-ledger": "node --experimental-strip-types review-ledger-cli.mjs",
    "audit:interaction-evidence": "node --experimental-strip-types interaction-evidence-cli.mjs",
    "audit:document-outline": "node --experimental-strip-types document-outline-cli.mjs"
  }
}
